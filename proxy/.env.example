NODE_ENV=development
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Add the literal null only when serving packaged webOS/Tizen TV clients.
UPSTREAM_TIMEOUT_MS=10000
CHART_CACHE_TTL_MS=60000
SEARCH_CACHE_TTL_MS=30000
# Phòng Nhạc directory cache; streams themselves are never cached.
LIVE_RADIO_CACHE_TTL_MS=30000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Number of trusted reverse-proxy hops (0 when directly exposed).
TRUST_PROXY_HOPS=0
PUBLIC_BASE_URL=http://localhost:8080
# Required in production; use at least 32 random characters.
STREAM_TOKEN_SECRET=replace-with-a-long-random-secret
STREAM_TOKEN_TTL_SECONDS=300
# HLS master/media child links need to survive a listening session.
LIVE_STREAM_TOKEN_TTL_SECONDS=21600
# Exact domains or parent suffixes; subdomains are accepted.
STREAM_HOSTS=zingmp3.vn,zmdcdn.me
# Public autocomplete endpoint used for catalog search.
ZING_SEARCH_URL=https://ac.zingmp3.vn/complete?type=artist,song,album&num=25
# Current autocomplete endpoint. Requests are signed only on the proxy when
# authorized credentials are configured; otherwise the legacy search fallback
# is normalized into the same client contract.
ZING_SUGGESTION_URL=https://ac.zingmp3.vn/v1/web/ac-suggestions
# Optional current-API adapter for Discovery Home, Topic/Genre hubs, Top 100,
# BXH Nhạc Mới, and catalog playback outside #zingchart.
# Configure only credentials that your deployment is authorized to use. Both
# values are required together; leave both blank to keep legacy/chart playback.
ZING_CURRENT_API_BASE_URL=https://zingmp3.vn
ZING_CURRENT_API_VERSION=1.20.1
ZING_CURRENT_API_KEY=
ZING_CURRENT_API_SIGNING_KEY=

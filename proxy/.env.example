NODE_ENV=development
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Add the literal null only when serving packaged webOS/Tizen TV clients.
UPSTREAM_TIMEOUT_MS=10000
CHART_CACHE_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Number of trusted reverse-proxy hops (0 when directly exposed).
TRUST_PROXY_HOPS=0
PUBLIC_BASE_URL=http://localhost:8080
# Required in production; use at least 32 random characters.
STREAM_TOKEN_SECRET=replace-with-a-long-random-secret
STREAM_TOKEN_TTL_SECONDS=300
# Exact domains or parent suffixes; subdomains are accepted.
STREAM_HOSTS=zingmp3.vn,zmdcdn.me
